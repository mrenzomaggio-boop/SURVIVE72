    "A receiver only listens: it does not need a network or an account.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ricevitore si limita ad ascoltare: non servono rete né account."
          }
        }
      }
    },
    "A simple portable receiver is enough to follow official updates.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un semplice ricevitore portatile basta per seguire gli aggiornamenti ufficiali."
          }
        }
      }
    },
