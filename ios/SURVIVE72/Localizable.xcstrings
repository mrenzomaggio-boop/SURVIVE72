        }
      }
    },
    "%lld topics": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld argomenti"
          }
        }
      }
    },
    "%lld topics in %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld argomenti in %2$@"
          }
        }
      }
    },
    "72-hour checklist": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Checklist 72 ore"
          }
        }
      }
    },
    "72-hour kit": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit 72 ore"
          }
        }
      }
    },
    "A burnt forearm under cool running tap water, with a timer.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avambraccio ustionato sotto l'acqua fresca corrente del rubinetto, con un timer."
          }
        }
      }
    },
    "A face with one corner of the mouth drooping, next to a phone showing 112.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viso con un angolo della bocca che scende, accanto a un telefono con il numero 112."
          }
        }
      }
    },
    "A first aid kit and your personal medicines.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassetta di pronto soccorso e i tuoi medicinali personali."
          }
        }
      }
    },
    "A person lying in the shade of a tree with legs raised, while a rescuer pours cool water on the neck.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona sdraiata all'ombra di un albero con le gambe sollevate, mentre un soccorritore le versa acqua fresca sul collo."
          }
        }
      }
    },
    "A person lying on their side, head tilted back, hand under the cheek, upper knee bent.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona sdraiata sul fianco, testa indietro, mano sotto la guancia, ginocchio di sopra piegato."
          }
        }
      }
    },
    "A person sitting in shelter, wrapped in a blanket, holding a warm drink.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona seduta al riparo, avvolta in una coperta, con una bevanda calda tra le mani."
          }
        }
      }
    },
    "A person sitting on the floor; the auto-injector is pressed against the outer side of the thigh.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona seduta a terra; l'autoiniettore è premuto sul lato esterno della coscia."
          }
        }
      }
    },
    "A receiver only listens: it does not need a network or an account.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ricevitore si limita ad ascoltare: non servono rete né account."
          }
        }
      }
    },
    "A rescuer kneels next to a person lying on their back, arms straight, hands in the centre of the chest, pushing down.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un soccorritore è in ginocchio accanto a una persona sdraiata sulla schiena, braccia dritte, mani al centro del petto, e spinge verso il basso."
          }
        }
      }
    },
    "A simple portable receiver is enough to follow official updates.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un semplice ricevitore portatile basta per seguire gli aggiornamenti ufficiali."
          }
        }
      }
    },
    "A strong earthquake felt on the coast.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un forte terremoto avvertito sulla costa."
          }
        }
      }
    },
    "A torch and a battery radio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torcia e radio a pile."
          }
        }
      }
    },
    "A wave comes in from the sea while a person runs up the hill to high ground.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'onda arriva dal mare mentre una persona corre su per la collina, verso l'alto."
          }
        }
      }
    },
    "AED": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DAE"
          }
        }
      }
    },
    "About %@ · estimate": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ · stima"
          }
        }
      }
    },
    "About 4 L per person per day, for 3 days": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 4 L a persona al giorno, per 3 giorni"
          }
        }
      }
    },
    "Adapted and summarised under the CC BY 4.0 licence. Not written by SURVIVE 72.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo adattato e riassunto con licenza CC BY 4.0. Non è stato scritto da SURVIVE 72."
          }
        }
      }
    },
    "Add contact": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi contatto"
          }
        }
      }
    },
    "Add place": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi luogo"
          }
        }
      }
    },
    "Add to queue": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi alla coda"
          }
        }
      }
    },
    "After": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo"
          }
        }
      }
    },
    "Agree with your family on a plan to reach escape routes and waiting areas.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concorda con la famiglia un piano per raggiungere vie di fuga e aree di attesa."
          }
        }
      }
    },
    "Agree with your family where to meet.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concorda con la famiglia dove ritrovarvi."
          }
        }
      }
    },
    "Alert": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerta"
          }
        }
      }
    },
    "Alert and SOS": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerta e SOS"
          }
        }
      }
    },
    "Alert and SOS. %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerta e SOS. %@"
          }
        }
      }
    },
    "Alert board": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bacheca allerte"
          }
        }
      }
    },
    "Alert board, SOS plan": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bacheca allerte, piano SOS"
          }
        }
      }
    },
    "Alert published.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerta pubblicata."
          }
        }
      }
    },
    "Alert text": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo dell'allerta"
          }
        }
      }
    },
    "Alerts": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerte"
          }
        }
      }
    },
    "Alerts are written by people, not by authorities, and are not verified. They disappear after 24 hours.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le allerte sono scritte dalle persone, non dalle autorità, e non sono verificate. Spariscono dopo 24 ore."
          }
        }
      }
    },
    "All": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti"
          }
        }
      }
    },
    "All items will be marked as not packed. This cannot be undone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli oggetti verranno segnati come non pronti. L'operazione non si può annullare."
          }
        }
      }
    },
    "Alternative power keeps the radio usable when batteries run out.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'alimentazione alternativa tiene la radio utilizzabile quando le batterie finiscono."
          }
        }
      }
    },
    "Amateur radio UHF": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Radioamatori UHF"
          }
        }
      }
    },
    "Amateur radio UHF calling frequency.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza di chiamata UHF dei radioamatori."
          }
        }
      }
    },
    "Amateur radio VHF": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Radioamatori VHF"
          }
        }
      }
    },
    "Amateur radio calling frequency, also used by emergency networks.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza di chiamata dei radioamatori, usata anche dalle reti di emergenza."
          }
        }
      }
    },
    "An arm with a wound; the tourniquet is tightened above the wound and a clock reminds you to write down the time.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un braccio con una ferita; il laccio è stretto sopra la ferita e un orologio ricorda di scrivere l'ora."
          }
        }
      }
    },
    "An earphone socket helps you listen quietly.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una presa per auricolari ti permette di ascoltare senza disturbare."
          }
        }
      }
    },
    "An emergency backpack with water, a torch, a first aid kit, a battery radio and documents.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno zaino di emergenza con acqua, torcia, cassetta di pronto soccorso, radio a pile e documenti."
          }
        }
      }
    },
    "An official alert message.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio di allerta ufficiale."
          }
        }
      }
    },
    "Anaphylaxis: call 112 and help the person use their adrenaline pen.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anafilassi: chiama il 112 e aiuta la persona a usare la sua penna di adrenalina."
          }
        }
      }
    },
    "Anything others should know": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cose che gli altri dovrebbero sapere"
          }
        }
      }
    },
    "Applies to the first message in the queue. Nothing is transmitted.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per il primo messaggio in coda. Non viene trasmesso nulla."
          }
        }
      }
    },
    "Areas on this iPhone: %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone su questo iPhone: %lld"
          }
        }
      }
    },
    "Arm: one arm is weak or cannot be lifted.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccio: un braccio è debole o non si alza."
          }
        }
      }
    },
    "Articles adapted from Io non rischio, the campaign of the Italian Civil Protection Department. Not written by SURVIVE 72. Always follow the instructions of the authorities.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Articoli adattati da Io non rischio, la campagna del Dipartimento della Protezione Civile. Non sono stati scritti da SURVIVE 72. Segui sempre le indicazioni delle autorità."
          }
        }
      }
    },
    "Ask a qualified technician whether your home needs strengthening.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatti consigliare da un tecnico su eventuali rinforzi della tua casa."
          }
        }
      }
    },
    "Ask someone to bring a defibrillator (AED).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai cercare un defibrillatore (DAE) da qualcuno."
          }
        }
      }
    },
    "Asks for confirmation, then clears every checked item.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede conferma, poi toglie tutte le spunte."
          }
        }
      }
    },
    "Asks for confirmation, then removes all SURVIVE 72 data from this device.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede conferma, poi rimuove tutti i dati di SURVIVE 72 da questo dispositivo."
          }
        }
      }
    },
    "Authorities often share updates on public broadcast stations.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le autorità spesso diffondono aggiornamenti sulle emittenti pubbliche."
          }
        }
      }
    },
    "Available: %lld of %lld · uses %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibili: %1$lld di %2$lld · occupano %3$@"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indietro"
          }
        }
      }
    },
    "Basics": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basi"
          }
        }
      }
    },
    "Batteries": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie"
          }
        }
      }
    },
    "Battery or hand-crank radio": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio a batterie o a manovella"
          }
        }
      }
    },
    "Battery saver": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmio batteria"
          }
        }
      }
    },
    "Before": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima"
          }
        }
      }
    },
    "Before going out, shut off gas, water and electricity and put on shoes.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di uscire chiudi gas, acqua e luce e mettiti le scarpe."
          }
        }
      }
    },
    "Before moving, check your route and avoid flood-prone areas.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di spostarti controlla il percorso ed evita le zone allagabili."
          }
        }
      }
    },
    "Bookmark": {
      "localizations": {
