    "Cool the area straight away with cool running water (not ice) for at least 20 minutes.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raffredda subito la zona con acqua corrente fresca (non ghiaccio) per almeno 20 minuti."
          }
        }
      }
    },
    "Cool the burn with running water and cover it with something clean.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raffredda l'ustione con acqua corrente e coprila con qualcosa di pulito."
          }
        }
      }
    },
    "Cool them down at once: if possible, immerse them in cool or cold water up to the neck. Otherwise wet their skin and fan them.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raffreddala subito: se possibile immergila in acqua fresca o fredda fino al collo. Altrimenti bagnale la pelle e falle vento."
          }
        }
      }
    },
