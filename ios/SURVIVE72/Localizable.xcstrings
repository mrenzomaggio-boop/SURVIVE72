    "More than one person declares this number. Numbers are not verified: check the security code with the person.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più persone dichiarano questo numero. I numeri non sono verificati: controlla il codice di sicurezza con la persona."
          }
        }
      }
    },
    "Move away from buildings, trees, street lights and power lines.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontanati da edifici, alberi, lampioni e linee elettriche."
          }
        }
      }
    },
    "Move away from electrical devices that cause noise.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontanati dagli apparecchi elettrici che causano disturbi."
          }
        }
      }
    },
    "Move away from the water: even a few centimetres of flowing water can knock you over.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontanati dall'acqua: anche pochi centimetri di acqua che scorre possono farti cadere."
          }
        }
      }
    },
    "Move heavy furniture away from beds and sofas. Fix shelves, bookcases and tall furniture to the wall.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontana i mobili pesanti da letti e divani. Fissa al muro scaffali, librerie e mobili alti."
          }
        }
      }
    },
    "Move straight away to the nearest high place: a hill or the upper floors of a building.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontanati subito verso il luogo elevato più vicino: una collina o i piani alti di un edificio."
          }
        }
      }
    },
    "Move the person into the shade or somewhere cool and remove excess clothing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la persona all'ombra o al fresco e togli i vestiti in eccesso."
          }
        }
      }
    },
    "Move the person out of the wind.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la persona al riparo dal vento."
          }
        }
      }
    },
    "Move the person somewhere cool and cool them down quickly.": {
      "localizations": {
