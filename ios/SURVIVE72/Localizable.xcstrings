    "Turn torch on": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accendi torcia"
          }
        }
      }
    },
    "Unconscious but breathing": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incosciente ma respira"
          }
        }
      }
    },
    "Units": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unità di misura"
          }
        }
      }
    },
    "Unmark": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli"
          }
        }
      }
