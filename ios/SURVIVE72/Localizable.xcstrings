{
  "sourceLanguage": "en",
  "strings": {
    " Enough space.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Spazio sufficiente."
          }
        }
      }
    },
    " Not enough space.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Spazio insufficiente."
          }
        }
      }
    },
    "%@ Missing packs need %@.%@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ I pacchetti mancanti richiedono %2$@.%3$@"
          }
        }
      }
    },
    "%@ Nothing missing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Non manca nulla."
          }
        }
      }
    },
    "%@ filter": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtro %@"
          }
        }
      }
    },
    "%@ not available yet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ancora disponibile"
          }
        }
      }
    },
    "%@ will be removed from this device.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verrà rimosso da questo dispositivo."
          }
        }
      }
    },
    "%@ will be removed from this iPhone. You can download it again later.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verrà eliminata da questo iPhone. Potrai scaricarla di nuovo in seguito."
          }
        }
      }
    },
    "%@ · on its way, delivery not confirmed": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · in viaggio, consegna non confermata"
          }
        }
      }
    },
    "%@ · received directly": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ricevuto direttamente"
          }
        }
      }
    },
