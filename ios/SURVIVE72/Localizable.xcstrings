      }
    },
    "The message is passed from phone to phone until it reaches this person. Delivery is not guaranteed.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio passa da telefono a telefono finché raggiunge questa persona. La consegna non è garantita."
          }
        }
      }
    },
    "The message is queued on this device. Nothing is transmitted.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio è in coda su questo dispositivo. Non viene trasmesso nulla."
          }
        }
      }
    },
    "The network between phones is off until you switch it on. Alerts are public; private messages are encrypted.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete tra telefoni è spenta finché non la accendi. Le allerte sono pubbliche; i messaggi privati sono cifrati."
          }
        }
      }
    },
    "The sea suddenly drawing back, a large wave or a deep, growing roar from the sea.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mare che si ritira all'improvviso, una grande onda o un rumore cupo e crescente dal mare."
          }
        }
      }
    },
    "The torch could not be switched. Close other apps using the camera and try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile accendere o spegnere la torcia. Chiudi le altre app che usano la fotocamera e riprova."
          }
        }
      }
    },
    "The warning signs of a tsunami and how to reach safety on the coast or at sea.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnali di un maremoto e come mettersi al sicuro sulla costa o in mare."
          }
        }
      }
    },
    "Thermal, compact": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Isotermica, compatta"
          }
        }
      }
    },
    "These cards do not replace a doctor or a first aid course. They are written by SURVIVE 72 following the European Resuscitation Council 2025 guidelines (Italian edition by Italian Resuscitation Council) and are not written or endorsed by ERC or IRC. SURVIVE 72 accepts no liability for how this information is used.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste schede non sostituiscono un medico né un corso di primo soccorso. Sono scritte da SURVIVE 72 seguendo le Linee guida 2025 dell'European Resuscitation Council (edizione italiana a cura di Italian Resuscitation Council) e non sono state scritte né approvate da ERC o IRC. SURVIVE 72 non si assume alcuna responsabilità per l'uso di queste informazioni."
          }
        }
      }
    },
    "This app never transmits and never accesses radio hardware.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non trasmette mai e non accede mai a hardware radio."
          }
        }
      }
    },
    "This device has no flash, or it cannot be used right now.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha il flash, oppure al momento non si può usare."
          }
        }
      }
    },
    "This does not look like a phone number.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sembra un numero di telefono."
          }
        }
      }
    },
    "Time: call 112 at once and note the time the symptoms started.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo: chiama subito il 112 e annota l'ora in cui sono iniziati i sintomi."
          }
        }
      }
    },
    "To receive official updates": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere gli aggiornamenti ufficiali"
          }
        }
      }
    },
    "To signal for help": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per chiedere aiuto"
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumenti"
          }
        }
      }
    },
    "Torch": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torcia"
          }
        }
      }
    },
    "Torch not available": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torcia non disponibile"
          }
        }
      }
    },
    "Traffic and emergency information, covers the motorway network.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni su traffico ed emergenze, copre la rete autostradale."
          }
        }
      }
    },
    "Transmitting allowed without a licence": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può trasmettere senza licenza"
          }
        }
      }
    },
    "Transmitting needs a marine radio certificate": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trasmettere serve il certificato radio marino"
          }
        }
      }
    },
    "Transmitting needs an amateur radio licence": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trasmettere serve la patente di radioamatore"
          }
        }
      }
    },
    "Transmitting needs the CB general authorisation": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trasmettere serve l'autorizzazione generale CB"
          }
        }
      }
    },
    "Try another word or choose All.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un'altra parola o scegli Tutti."
          }
        }
      }
    },
    "Try near a window or outdoors.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova vicino a una finestra o all'aperto."
          }
        }
      }
    },
    "Tsunami": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maremoto"
          }
        }
      }
    },
    "Tsunami: what to do": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maremoto: cosa fare"
          }
        }
      }
    },
    "Turn torch off": {
