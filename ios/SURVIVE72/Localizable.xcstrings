        }
      }
    },
    "Shows ... --- ... on the screen in white and black. Slow pattern: at most one flash per second, never starts by itself.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ... --- ... sullo schermo in bianco e nero. Sequenza lenta: al massimo un lampo al secondo, non parte mai da sola."
          }
        }
      }
    },
    "Shows a slow SOS light pattern on this screen. Nothing is sent.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra su questo schermo una lenta sequenza luminosa SOS. Non viene inviato nulla."
