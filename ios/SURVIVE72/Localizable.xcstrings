      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermo e batteria"
          }
        }
      }
    },
    "Distress and calling at sea, monitored by the Coast Guard.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soccorso e chiamata in mare, ascoltato dalla Guardia Costiera."
          }
        }
      }
    },
    "Do not drink tap water and do not eat food touched by sea water.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non bere l'acqua del rubinetto e non mangiare cibi bagnati dal mare."
          }
        }
      }
    },
    "Do not drink tap water until your municipality allows it. Throw away food that touched the flood water.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non bere l'acqua del rubinetto finché il Comune non lo permette. Butta i cibi venuti a contatto con l'acqua dell'alluvione."
          }
        }
      }
    },
    "Do not drink tap water: it may be contaminated.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non bere l'acqua del rubinetto: potrebbe essere contaminata."
          }
        }
      }
    },
    "Do not drive. Avoid underpasses, riverbanks and bridges.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non usare l'auto. Evita sottopassi, argini e ponti."
          }
        }
      }
    },
    "Do not go back into your home until you are allowed to.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rientrare in casa finché non sei autorizzato."
          }
        }
      }
    },
    "Do not go down to cellars or garages and do not go out to move the car.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non scendere in cantina o in garage e non uscire per spostare l'auto."
          }
        }
      }
    },
    "Do not rush outside: wait until the shaking stops.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non precipitarti fuori: aspetta che la scossa finisca."
          }
        }
      }
    },
    "Do not sleep or stay in basements.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dormire e non restare nei piani seminterrati."
          }
        }
      }
    },
    "Do not spread unconfirmed information heard on the radio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non diffondere informazioni non confermate sentite alla radio."
          }
        }
      }
    },
    "Do not use the car: it can become a trap.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non usare l'auto: può diventare una trappola."
          }
        }
      }
    },
    "Do not use the lift and be careful on the stairs, which may be damaged.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non usare l'ascensore e fai attenzione alle scale, che potrebbero essere danneggiate."
          }
        }
      }
    },
    "Do not walk or drive on flooded roads.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non percorrere strade allagate, né a piedi né in auto."
          }
        }
      }
    },
