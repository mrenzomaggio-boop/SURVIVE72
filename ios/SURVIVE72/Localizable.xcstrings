      }
    },
    "Shows one step at a time in very large text.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un passo alla volta con testo molto grande."
          }
        }
      }
    },
    "Shut off the gas and the electricity. Do not touch electrical devices if you are wet.": {
      "localizations": {
