    "Unmark %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli %@ dai pronti"
          }
        }
      }
    },
    "Use a sealed bag or box.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una busta o una scatola sigillata."
          }
        }
      }
    },
    "Use my SOS message": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il mio messaggio SOS"
          }
        }
      }
    },
    "Use the phone as little as possible and the car only if necessary, to keep the way clear for rescuers.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il telefono il meno possibile e l'auto solo se necessario, per non ostacolare i soccorsi."
          }
        }
      }
    },
    "Uses Bluetooth and Wi-Fi between phones, without internet. It works while the app is open, with phones a few tens of metres away. iOS will ask for permission the first time.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Bluetooth e Wi-Fi tra telefoni, senza internet. Funziona con l'app aperta e con telefoni a qualche decina di metri. La prima volta iOS chiederà il permesso."
          }
        }
      }
    },
    "Uses the iPhone flash": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il flash dell'iPhone"
          }
        }
      }
    },
    "Uses the iPhone flash only: no camera access, no permission. The torch switches off when you leave the app. It uses a lot of battery.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo il flash dell'iPhone: nessun accesso alla fotocamera, nessun permesso. La torcia si spegne quando esci dall'app. Consuma molta batteria."
          }
        }
      }
    },
    "Uses the screen only. No torch, no sound, nothing is sent.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo lo schermo. Niente torcia, niente suoni, non viene inviato nulla."
          }
        }
      }
    },
    "Vibrates at the pace of chest compressions.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra al ritmo delle compressioni sul petto."
          }
        }
      }
    },
    "Visual SOS": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS visivo"
          }
        }
      }
    },
    "Voice prompts (demo)": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Istruzioni vocali (demo)"
          }
        }
      }
    },
    "Warm clothes and rain gear": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestiti caldi e antipioggia"
          }
        }
      }
    },
    "Warn the people around you.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa le persone intorno a te."
          }
        }
      }
    },
    "Warning signs": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnali di pericolo"
          }
        }
      }
    },
    "Watch out for damaged bridges, landslides and gas leaks.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai attenzione a ponti danneggiati, frane e perdite di gas."
          }
        }
      }
    },
    "Watch where you step: there may be holes and open manholes.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda dove metti i piedi: potrebbero esserci buche e tombini aperti."
          }
        }
      }
    },
    "Water": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acqua"
          }
        }
      }
    },
    "Water purification": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potabilizzazione dell'acqua"
          }
        }
      }
    },
    "What is happening and where": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sta succedendo e dove"
          }
        }
      }
    },
    "What to keep ready": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa tenere pronto"
          }
        }
      }
    },
    "What to keep ready at home for any emergency.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa tenere pronto in casa per qualsiasi emergenza."
          }
        }
      }
    },
    "When the AED arrives, switch it on and follow the voice.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arriva il DAE, accendilo e segui le istruzioni vocali."
          }
        }
      }
    },
    "Where your group meets": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si ritrova il tuo gruppo"
          }
        }
      }
    },
    "Whistle": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fischietto"
          }
        }
      }
    },
    "Whole countries": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paesi interi"
          }
        }
      }
    },
    "Why a radio matters": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché una radio è importante"
          }
        }
      }
    },
    "With a number, people who already know it can find you on the network. The number itself is not sent: only a fingerprint of it travels. It is not verified, and someone with technical skills could work it out. Leave it empty if you prefer.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il numero, chi lo conosce già può trovarti nella rete. Il numero in sé non viene inviato: viaggia solo una sua impronta. Non è verificato, e chi ha competenze tecniche potrebbe risalire al numero. Lascialo vuoto se preferisci."
          }
        }
      }
    },
    "Works without internet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona senza internet"
          }
        }
      }
    },
    "Works without internet once an area is downloaded": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona senza internet dopo aver scaricato una zona"
          }
        }
      }
    },
    "Works without power": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona senza corrente"
          }
        }
      }
    },
    "Write an alert": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un'allerta"
          }
        }
      }
    },
    "Write down key information on paper.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota su carta le informazioni importanti."
          }
        }
      }
    },
    "Written by you": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritta da te"
          }
        }
      }
    },
    "Written on paper": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritti su carta"
          }
        }
      }
    },
    "Your SOS will be shown first on every phone it reaches. It does not call emergency services. Use it only for a real emergency.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo SOS comparirà per primo su ogni telefono che raggiunge. Non chiama i servizi di emergenza. Usalo solo per un'emergenza vera."
          }
        }
      }
    },
    "Your data stays on this device, except the alerts and messages you choose to send.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano su questo dispositivo, tranne le allerte e i messaggi che scegli di inviare."
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome"
          }
        }
      }
    },
    "Your position needs GPS and location permission. It will be enabled after it has been tested on a real iPhone. This version never reads your location: type coordinates in Saved places instead.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione richiede il GPS e il permesso di localizzazione. Verrà attivata dopo essere stata provata su un iPhone reale. Questa versione non legge mai la tua posizione: inserisci invece le coordinate in Luoghi salvati."
          }
        }
      }
    },
    "Your profile": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo"
          }
        }
      }
    },
