    "Demo: All fine here. Water and food ready.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Qui tutto bene. Acqua e cibo pronti."
          }
        }
      }
    },
    "Demo: Check-in at the agreed time.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Fatevi sentire all'orario concordato."
          }
        }
      }
    },
    "Demo: Everyone ok? Reply when you can.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Tutti bene? Rispondete appena potete."
          }
        }
      }
    },
    "Demo: Meet at the usual place if needed.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Se serve, ci vediamo al solito posto."
          }
        }
      }
    },
    "Demo: Power is out on our street.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Nella nostra via manca la corrente."
          }
        }
      }
    },
    "Demo: We have spare blankets if anyone needs them.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: Abbiamo coperte in più se a qualcuno servono."
          }
